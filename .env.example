# --- Immich ---------------------------------------------------------------------------
# Optional: the connection can also be set in the dashboard (Settings > Immich), which tests the address and
# the key and says which permission is missing. Set here, these values take precedence and are locked there.
# Immich URL as seen from the container (internal network preferably).
IMMICH_URL=
# Dedicated API key, created in Immich > Account Settings > API Keys, with ONLY:
#   asset.read asset.update asset.view server.about tag.asset tag.create tag.delete tag.read
# Optional: also ticking asset.download lets small subjects (distant bird, insect) be identified
# on the full-resolution original rather than on the preview (1440 px on the short side). Read-only.
IMMICH_API_KEY=
# URL used for the "open in Immich" links of the dashboard (optional).
IMMICH_PUBLIC_URL=

# --- Photo source ------------------------------------------------------------------
# immich (default) or local: a folder mounted in the container on PHOTOS_DIR; results are written in
# XMP files next to the photos (see README, "Photo source"). With local, the Immich section is ignored.
# Desktop edition only: darktable or lightroom (their library, CATALOG_PATH: library.db or .lrcat),
# rawtherapee or rapidraw (a folder, PHOTOS_DIR).
SOURCE=immich
PHOTOS_DIR=/photos
# CATALOG_PATH=/home/me/.config/darktable/library.db

# --- Safety -------------------------------------------------------------------------
# Nothing is written to Immich until this is false. Start with true, review,
# then switch to false. `taxonero uninstall --apply` undoes everything that was written.
DRY_RUN=true

# --- Analysis --------------------------------------------------------------------------
# Compute: auto = GPU if a usable one exists, otherwise CPU (auto | cpu | cuda | xpu | mps).
# Also editable in the dashboard (Settings > Compute), which then takes precedence over this value.
DEVICE=auto
# Hardware of the machine: image used and GPU access (hwaccel.yml). Filled in by ./detect-gpu.sh:
#   cuda13 (NVIDIA, driver >= 580) | cuda12 (NVIDIA, driver >= 525) | rocm (AMD, untested)
#   | xpu (Intel Arc and Core Ultra, untested) | cpu (no GPU)
#   The Settings > AI models page shows what is actually used.
GPU=cpu
# Image version (ghcr.io/adn-dan/taxonero:<VERSION>-<GPU>): latest, or a pinned version such as 0.1.0.
VERSION=latest
# AMD and Intel only: group owning /dev/dri/renderD* on this machine (filled in by ./detect-gpu.sh).
# RENDER_GID=
# OWLv2 (plants, fungi, insects): auto (default: always on GPU, fallback on CPU)
# | always (every photo) | fallback (only if MegaDetector finds no animal). Settings > Compute.
# OPEN_DETECTOR=false disables it completely (model never loaded).
OPEN_DETECTOR_MODE=auto
# GPU: photos analysed together. 0 (default): automatic from the GPU memory (8 for 12 GB, 16 for 24 GB), halved
# on its own if the memory runs out. Larger: faster, more GPU memory. No effect on the CPU.
# Editable in Settings > Compute.
GPU_BATCH=0
# GPU: models removed from its memory after this time without analysis (minutes), reloaded at the next one. 0: always kept.
MODELS_IDLE_MINUTES=5
ANALYSIS_WINDOW=01:00-07:00      # analysis window (empty = continuous)
INTERVAL_MINUTES=15
BATCH_SIZE=200
# Maximum analysis time per cycle; if photos remain, a new cycle starts right away
# (tags of confirmed photos are written in between).
ANALYSIS_MAX_MINUTES=30

# Auto-confirmation: rule | calibrated | fixed | off
#   rule (default): confidence >= AUTO_CONFIRM_THRESHOLD, species observed nearby (green badge)
#                   and no other candidate above AUTO_CONFIRM_MAX_RUNNER_UP. After
#                   AUTO_CONFIRM_MIN_REVIEWS reviews, the threshold calibrated on your reviews
#                   replaces the threshold if it is stricter.
#   calibrated    : nothing auto-confirmed before calibration.
AUTO_CONFIRM=rule
AUTO_CONFIRM_THRESHOLD=0.85
AUTO_CONFIRM_MAX_RUNNER_UP=0.05
AUTO_CONFIRM_TARGET_PRECISION=0.98
AUTO_CONFIRM_MIN_REVIEWS=100
# Share of the detections that would have been auto-confirmed, kept for review at random ("Check" filter):
# measures the real reliability of auto-confirmation. 0 = no check.
AUTO_CONFIRM_AUDIT=0.05

# Domestic animals (dogs, cats, horses, cattle, hens): skip = ignored, keep = treated like the others
DOMESTIC_ANIMALS=skip

# Excluded candidates. EXCLUDE_EXTINCT: species known mostly from fossils (more than 5 fossils
# per field observation in GBIF). HIDE_ABSENT: for geotagged photos, species never
# observed in the region (red badge); risk of missing a rare species.
EXCLUDE_EXTINCT=true
HIDE_ABSENT=false
# Detection: auto (the detectors look for subjects) or manual (no automatic detection, boxes drawn
# by hand in the viewer). DETECT_GROUPS: groups searched, among animal, plant, fungus, microbe (lichens
# with fungi, algae with plants; microbe: bacteria, viruses and microscopic protists, answers
# almost always wrong in photos, hence not searched by default). Also adjustable in the dashboard (Settings > Detection).
DETECTION=auto
DETECT_GROUPS=animal,plant,fungus
# Local GBIF taxonomy (names, synonyms, lineages): downloaded once at startup (~0.9 GB, deleted
# afterwards) and converted to data/gbif-backbone.sqlite (~1.5 GB, about ten minutes). Avoids most
# GBIF requests of the analysis; meanwhile, and for common names and IUCN, the GBIF API is used.
GBIF_LOCAL=true

# --- Writing to Immich -------------------------------------------------------------
TAG_ROOT=Nature
# Starting language of the tags and description, then set in Settings > General (also: scientific names only).
# Unset on a new install: the language of the dashboard interface. Set it to keep tags already written.
# NAMES_LANG=fr
NAMES_LANGS=fr,en,de,es,it,nl,pt,ca,br,eu,oc,pl,sv,ja,zh   # names shown in the dashboard
WRITE_DESCRIPTION=true

# --- Dashboard ------------------------------------------------------------------------
# User: nature. Required unless DASHBOARD_NO_AUTH=true (trusted network only).
# ASCII characters only (no accents): HTTP Basic authentication does not transmit them reliably.
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8765
# Behind a proxy or Cloudflare Tunnel: IP address of the proxy as seen by taxonero (several: separated by
# commas). Without it, all visitors share its address, and 10 wrong passwords lock everyone out
# for a minute. "*" only if the port can only be reached through the proxy: otherwise the address can be spoofed.
# FORWARDED_ALLOW_IPS=172.18.0.2
# Public identification page (/identify), without login or password: anyone who has the address can send one image
# and see what is recognised in it. Nothing else is open (photos, species, settings), and the image is not kept.
# Limited to 20 images per address every 10 minutes (per visitor only with FORWARDED_ALLOW_IPS behind a proxy).
# Off by default; also set in Settings > General.
# PUBLIC_IDENTIFY=false

# --- Backup -------------------------------------------------------------------------
# Daily copy of the database (reviews, detections; without the network caches) in ./data/backups:
# number of days kept, 0 = disabled.
BACKUP_KEEP=7

# --- Container --------------------------------------------------------------------------
# Time zone of the container (time of the ANALYSIS_WINDOW analysis range); UTC if absent.
TZ=Europe/Paris
# Maximum memory of the container: beyond it, only this container is stopped (and restarted), not Immich or the
# rest of the server. On the CPU, count ~4 GB for the models, plus the disk cache of the BioCLIP
# embeddings (2.7 GB, reclaimable). With a GPU, the card memory adds up and does not count here.
MEM_LIMIT=8g
# uid:gid of the process, owner of the ./data folder (TrueNAS SCALE: often 568).
PUID=1000
PGID=1000
