# --- Immich ---------------------------------------------------------------------------
# Facultatif : la connexion se règle aussi dans le dashboard (Paramètres > Immich), qui teste l'adresse et
# la clé et dit quelle permission manque. Définies ici, ces valeurs priment et y sont verrouillées.
# URL d'Immich vue depuis le conteneur (réseau interne de préférence).
IMMICH_URL=
# Clé API dédiée, créée dans Immich > Paramètres du compte > Clés API, avec UNIQUEMENT :
#   asset.read asset.update asset.view server.about tag.asset tag.create tag.delete tag.read
# Facultatif : cocher aussi asset.download permet d'identifier les petits sujets (oiseau lointain, insecte)
# sur l'original en pleine résolution plutôt que sur l'aperçu (1440 px sur le petit côté). Lecture seule.
IMMICH_API_KEY=
# URL utilisée pour les liens « ouvrir dans Immich » du dashboard (optionnel).
IMMICH_PUBLIC_URL=

# --- Source des photos ------------------------------------------------------------------
# immich (défaut) ou local : un dossier monté dans le conteneur sur PHOTOS_DIR ; les résultats sont écrits dans
# des fichiers XMP à côté des photos (voir README, « Source des photos »). Avec local, la section Immich est ignorée.
# Édition de bureau seulement : darktable ou lightroom (leur bibliothèque, CATALOG_PATH : library.db ou .lrcat),
# rawtherapee ou rapidraw (un dossier, PHOTOS_DIR).
SOURCE=immich
PHOTOS_DIR=/photos
# CATALOG_PATH=/home/moi/.config/darktable/library.db

# --- Sécurité -------------------------------------------------------------------------
# Rien n'est écrit dans Immich tant que ce n'est pas à false. Commence par true, relis,
# puis passe à false. `taxonero uninstall --apply` annule tout ce qui a été écrit.
DRY_RUN=true

# --- Analyse --------------------------------------------------------------------------
# Calcul : auto = GPU s'il y en a un d'utilisable, sinon processeur (auto | cpu | cuda | xpu | mps).
# Modifiable aussi dans le dashboard (Paramètres > Calcul), qui prime alors sur cette valeur.
DEVICE=auto
# Matériel de la machine : image utilisée et accès au GPU (hwaccel.yml). Rempli par ./detect-gpu.sh :
#   cuda13 (NVIDIA, pilote >= 580) | cuda12 (NVIDIA, pilote >= 525) | rocm (AMD, non testé)
#   | xpu (Intel Arc et Core Ultra, non testé) | cpu (sans GPU)
#   La page Paramètres > Modèles d'IA montre ce qui est réellement utilisé.
GPU=cpu
# Version de l'image (ghcr.io/adn-dan/taxonero:<VERSION>-<GPU>) : latest, ou une version figée comme 0.1.0.
VERSION=latest
# AMD et Intel seulement : groupe propriétaire de /dev/dri/renderD* sur cette machine (rempli par ./detect-gpu.sh).
# RENDER_GID=
# OWLv2 (plantes, champignons, insectes) : auto (défaut : toujours sur GPU, en repli sur processeur)
# | always (chaque photo) | fallback (seulement si MegaDetector ne trouve aucun animal). Paramètres > Calcul.
# OPEN_DETECTOR=false le désactive complètement (modèle jamais chargé).
OPEN_DETECTOR_MODE=auto
# GPU : photos analysées ensemble (plus grand : plus rapide, plus de mémoire du GPU ; 8 pour 12 Go). Sans effet
# sur processeur. Modifiable dans Paramètres > Calcul.
GPU_BATCH=8
# GPU : modèles retirés de sa mémoire après ce temps sans analyse (minutes), rechargés à la suivante. 0 : toujours gardés.
MODELS_IDLE_MINUTES=5
ANALYSIS_WINDOW=01:00-07:00      # fenêtre d'analyse (vide = en continu)
INTERVAL_MINUTES=15
BATCH_SIZE=200
# Durée maximale d'analyse par cycle ; s'il reste des photos, un nouveau cycle repart aussitôt
# (les tags des photos validées sont écrits entre deux).
ANALYSIS_MAX_MINUTES=30

# Auto-validation : rule | calibrated | fixed | off
#   rule (défaut) : confiance >= AUTO_CONFIRM_THRESHOLD, espèce observée à proximité (badge vert)
#                   et aucun autre candidat au-dessus de AUTO_CONFIRM_MAX_RUNNER_UP. Après
#                   AUTO_CONFIRM_MIN_REVIEWS relectures, le seuil calibré sur tes relectures
#                   remplace le seuil s'il est plus strict.
#   calibrated    : rien d'auto-validé avant calibration.
AUTO_CONFIRM=rule
AUTO_CONFIRM_THRESHOLD=0.85
AUTO_CONFIRM_MAX_RUNNER_UP=0.05
AUTO_CONFIRM_TARGET_PRECISION=0.98
AUTO_CONFIRM_MIN_REVIEWS=100
# Part des détections qui auraient été auto-validées, gardées à relire au hasard (filtre « Contrôle ») :
# mesure la fiabilité réelle de l'auto-validation. 0 = aucun contrôle.
AUTO_CONFIRM_AUDIT=0.05

# Animaux domestiques (chiens, chats, chevaux, bétail, poules) : skip = ignorés, keep = traités comme les autres
DOMESTIC_ANIMALS=skip

# Candidats écartés. EXCLUDE_EXTINCT : espèces connues surtout par des fossiles (plus de 5 fossiles
# par observation de terrain dans GBIF). HIDE_ABSENT : pour les photos géolocalisées, espèces jamais
# observées dans la région (badge rouge) ; risque de manquer une espèce rare.
EXCLUDE_EXTINCT=true
HIDE_ABSENT=false
# Détection : auto (les détecteurs cherchent les sujets) ou manual (aucune détection automatique, rectangles tracés
# à la main dans la visionneuse). DETECT_GROUPS : groupes cherchés, parmi animal, plant, fungus, microbe (lichens
# avec les champignons, algues avec les plantes ; microbe : bactéries, virus et protistes microscopiques, réponses
# presque toujours fausses en photo, donc non cherchés par défaut). Réglables aussi dans le dashboard (Paramètres > Détection).
DETECTION=auto
DETECT_GROUPS=animal,plant,fungus
# Taxonomie GBIF en local (noms, synonymes, lignées) : téléchargée une fois au démarrage (~0,9 Go, supprimé
# ensuite) et convertie en data/gbif-backbone.sqlite (~1,5 Go, une dizaine de minutes). Évite la plupart des
# requêtes GBIF de l'analyse ; en attendant, et pour les noms communs et l'UICN, l'API GBIF sert.
GBIF_LOCAL=true

# --- Écriture dans Immich -------------------------------------------------------------
TAG_ROOT=Nature
NAMES_LANG=fr                    # langue des tags et de la description
NAMES_LANGS=fr,en,de,es,it,nl,pt,ca,br,eu,oc,pl,sv,ja,zh   # noms affichés dans le dashboard
WRITE_DESCRIPTION=true

# --- Dashboard ------------------------------------------------------------------------
# Utilisateur : nature. Obligatoire sauf DASHBOARD_NO_AUTH=true (réseau de confiance uniquement).
# Caractères ASCII seulement (pas d'accent) : l'authentification HTTP Basic ne les transmet pas de façon fiable.
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8765
# Derrière un proxy ou Cloudflare Tunnel : adresse IP du proxy vu par taxonero (plusieurs : séparées par des
# virgules). Sans cela, tous les visiteurs partagent son adresse, et 10 mots de passe faux bloquent tout le monde
# pendant une minute. « * » seulement si le port n'est joignable que par le proxy : sinon l'adresse est falsifiable.
# FORWARDED_ALLOW_IPS=172.18.0.2

# --- Sauvegarde -------------------------------------------------------------------------
# Copie quotidienne de la base (relectures, détections ; sans les caches réseau) dans ./data/backups :
# nombre de jours gardés, 0 = désactivée.
BACKUP_KEEP=7

# --- Conteneur --------------------------------------------------------------------------
# Fuseau horaire du conteneur (heure de la plage d'analyse ANALYSIS_WINDOW) ; UTC si absent.
TZ=Europe/Paris
# Mémoire maximale du conteneur : au-delà, seul ce conteneur est arrêté (et relancé), pas Immich ni le
# reste du serveur. Sur processeur, compter ~4 Go pour les modèles, plus le cache disque des empreintes
# BioCLIP (2,7 Go, récupérable). Avec un GPU, la mémoire de la carte s'ajoute et ne compte pas ici.
MEM_LIMIT=8g
# uid:gid du processus, propriétaire du dossier ./data (TrueNAS SCALE : souvent 568).
PUID=1000
PGID=1000
